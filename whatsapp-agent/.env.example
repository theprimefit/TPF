# --- WhatsApp Cloud API (Meta) ---
# From developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAG...                 # permanent system-user access token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_APP_SECRET=abc123             # App settings → Basic → App secret (verifies webhook signatures)
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_API_VERSION=v21.0

# Approved template used for follow-ups outside the 24-hour window (leave blank to skip those)
FOLLOWUP_TEMPLATE_NAME=lead_followup
FOLLOWUP_TEMPLATE_LANG=en

# --- Claude (AI replies) --- leave blank to run the built-in rule-based replies
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low                      # low keeps replies fast; raise to medium for more careful answers

# --- Server / dashboard ---
PORT=3000
DASHBOARD_TOKEN=change-me              # required to open /dashboard and /api/*
DATA_FILE=./data/leads.json
# Team members' WhatsApp numbers (comma-separated, with country code) alerted when a lead turns hot
ALERT_NUMBERS=

# --- Payments ---
# Public HTTPS address of this server, used to send the UPI QR image (put it at public/media/upi-qr.jpg)
PUBLIC_URL=https://your-domain.com
# Or point straight at a hosted QR image instead
PAYMENT_QR_URL=
